FROM node:20-alpine

# Ensure yarn is available (install with --force to overwrite if it already exists)
RUN npm install -g yarn --force

# Verify npm and yarn are available and create symlinks if needed
RUN which npm && which yarn && \
    npm --version && \
    yarn --version

# Set working directory
WORKDIR /app

# Copy package files
COPY src/package*.json ./

# Install dependencies
RUN yarn install

# Copy source code
COPY src/. .

# Copy entrypoint script for environment variable substitution
COPY src/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Expose port 8080 for development server (matching docker-compose)
EXPOSE 8080

# Use entrypoint to replace environment variables, then start dev server
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["sh", "-c", "HOST=0.0.0.0 PORT=8080 yarn start"]
