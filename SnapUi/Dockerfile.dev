FROM node:20-alpine

# Disable corepack to prevent Yarn 4.x from being used
RUN corepack disable

# Install Yarn 1.x (classic) - more compatible with volume mounts in dev
RUN npm install -g yarn@1.22.22 --force

# Verify npm and yarn are available
RUN which npm && which yarn && \
    npm --version && \
    yarn --version

# Set working directory
WORKDIR /app

# Copy package files
COPY src/package*.json ./

# Install dependencies and generate lockfile
RUN yarn install --frozen-lockfile || yarn install

# Copy source code
COPY src/. .

# Copy entrypoint script for environment variable substitution
COPY src/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Copy runtime-config template (will be used to generate runtime-config.js at startup)
COPY src/public/runtime-config.template.js /app/public/runtime-config.template.js

# Expose port 8080 for development server (matching docker-compose)
EXPOSE 8080

# Use entrypoint to replace environment variables, then start dev server
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["sh", "-c", "export PATH=/usr/local/bin:$PATH && HOST=0.0.0.0 PORT=8080 yarn start"]
