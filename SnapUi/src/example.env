# Required environment variables for SnapUI
# These must be set when running with docker-compose

# For direct access (no reverse proxy):
API_URL=http://localhost:8000
WS_URL=ws://localhost:8000

# For reverse proxy setup (set to empty strings to use relative paths):
# API_URL=
# WS_URL=

# Optional React app configuration
REACT_APP_USERNAME=admin
REACT_APP_PASSWORD=admin